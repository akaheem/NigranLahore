# Copy to `.env` and run with `npm run start:local`.
#
# `node --env-file=.env` is how these are loaded — Node 20.6+ reads the file
# itself, so the service has no dotenv dependency. The `start` and `dev`
# scripts deliberately do NOT use --env-file: on Render the environment comes
# from the dashboard and there is no .env file for Node to read.

# Matches docker-compose.yml. Note the port: 5433, not 5432, so a Postgres
# already running on this machine is not shadowed.
DATABASE_URL=postgres://nigran:nigran@localhost:5433/nigran

# Required on every write. There is no default and an unset value fails CLOSED
# — every write is refused rather than every write allowed. See index.js.
DEMO_WRITE_TOKEN=dev-token

# Browser origins allowed to call this service. The Vite dev server and the
# preview server Playwright builds to.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

PORT=3000
